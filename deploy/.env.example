# Auth.js session-signing secret; generate a unique high-entropy value. The
# deploy script also maps this value to the web application's NEXTAUTH_SECRET
# contract.
AUTH_SECRET=replace-me
# One effective auth mode is shared by the API and web build/runtime.
# `optional` remains valid with all three Zitadel values below left empty.
AUTH_MODE=optional
# API application secret; generate a unique high-entropy value.
SECRET_KEY=replace-me
# Key used to encrypt stored GitHub tokens; generate a unique high-entropy value.
GITHUB_TOKEN_ENCRYPTION_KEY=replace-me
# PostgreSQL superuser password used by the database and Zitadel administration.
POSTGRES_PASSWORD=replace-me
# Password for the OntoKit PostgreSQL role; generate a unique value.
ONTOKIT_DB_PASSWORD=replace-me
# MinIO root/access-key user; generate a unique value.
MINIO_ROOT_USER=replace-me
# MinIO root/secret-key password; generate a unique high-entropy value.
MINIO_ROOT_PASSWORD=replace-me
# Zitadel instance master key; replace with exactly 32 characters.
ZITADEL_MASTERKEY=00000000000000000000000000000000
# Initial Zitadel administrator password; generate a unique value.
ZITADEL_ADMIN_PASSWORD=replace-me
# Password for the Zitadel PostgreSQL role; generate a unique value.
ZITADEL_DB_PASSWORD=replace-me
# OIDC client identifier created by the Zitadel setup script. In optional mode,
# leave issuer, client ID, and client secret empty together to run without
# Zitadel; when any is configured, all three plus AUTH_SECRET are required.
ZITADEL_CLIENT_ID=replace-me
# OIDC client secret created by the Zitadel setup script.
ZITADEL_CLIENT_SECRET=replace-me
# Zitadel service-account token used by the API.
ZITADEL_SERVICE_TOKEN=replace-me
# Public Zitadel issuer URL for DEV.
ZITADEL_ISSUER=https://ontokit-auth.dev.openlegalstandard.org
# Comma-separated Zitadel user IDs granted superadmin access.
SUPERADMIN_USER_IDS=replace-with-zitadel-user-id
# Optional exact private LLM origins, e.g. http://llm-gateway.internal:8080.
# Leave empty unless an operator has approved the destination; wildcards are unsupported.
ONTOKIT_PRIVATE_LLM_ORIGINS=
# Public OIDC client identifier baked into the web application.
NEXT_PUBLIC_ZITADEL_CLIENT_ID=replace-me
