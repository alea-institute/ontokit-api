# Auth.js session-signing secret; generate a unique high-entropy value.
AUTH_SECRET=replace-me
# API application secret; generate a unique high-entropy value.
SECRET_KEY=replace-me
# Key used to encrypt stored GitHub tokens; generate a unique high-entropy value.
GITHUB_TOKEN_ENCRYPTION_KEY=replace-me
# Zitadel instance master key; replace with exactly 32 characters.
ZITADEL_MASTERKEY=00000000000000000000000000000000
# Initial Zitadel administrator password; generate a unique value.
ZITADEL_ADMIN_PASSWORD=replace-me
# Password for the Zitadel PostgreSQL role; generate a unique value.
ZITADEL_DB_PASSWORD=replace-me
# OIDC client identifier created by the Zitadel setup script.
ZITADEL_CLIENT_ID=replace-me
# OIDC client secret created by the Zitadel setup script.
ZITADEL_CLIENT_SECRET=replace-me
# Zitadel service-account token used by the API.
ZITADEL_SERVICE_TOKEN=replace-me
# Public Zitadel issuer URL for DEV.
ZITADEL_ISSUER=https://ontokit-auth.dev.openlegalstandard.org
# Comma-separated Zitadel user IDs granted superadmin access.
SUPERADMIN_USER_IDS=replace-with-zitadel-user-id
# Public OIDC client identifier baked into the web application.
NEXT_PUBLIC_ZITADEL_CLIENT_ID=replace-me
